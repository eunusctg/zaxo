{
    "name": "Zaxo",
    "short_name": "Zaxo",
    "description": "Message & Call Freely. 100% Free Forever. Secure, fast, and beautiful messaging app.",
    "start_url": "/",
    "display": "standalone",
    "orientation": "portrait",
    "scope": "/",
    "lang": "en",
    "dir": "ltr",
    "theme_color": "#7C3AED",
    "background_color": "#0F0F1A",

    "categories": ["social", "communication", "messaging"],

    "icons": [
        {
            "src": "icons/icon-72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-152.png",
            "sizes": "152x152",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "icons/icon-384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],

    "screenshots": [
        {
            "src": "screenshots/chat-list.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Chat list view"
        },
        {
            "src": "screenshots/chat-detail.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Chat detail view"
        },
        {
            "src": "screenshots/video-call.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Video call view"
        }
    ],

    "shortcuts": [
        {
            "name": "New Chat",
            "short_name": "Chat",
            "description": "Start a new chat",
            "url": "/?action=new-chat",
            "icons": [
                {
                    "src": "icons/shortcut-chat.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "New Call",
            "short_name": "Call",
            "description": "Start a new call",
            "url": "/?action=new-call",
            "icons": [
                {
                    "src": "icons/shortcut-call.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Status",
            "short_name": "Status",
            "description": "View status updates",
            "url": "/?action=status",
            "icons": [
                {
                    "src": "icons/shortcut-status.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],

    "related_applications": [],
    "prefer_related_applications": false,

    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "images",
                    "accept": ["image/*"]
                },
                {
                    "name": "videos",
                    "accept": ["video/*"]
                }
            ]
        }
    },

    "protocol_handlers": [
        {
            "protocol": "web+zaxo",
            "url": "/?deep-link=%s"
        }
    ],

    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"]
}
